{
  "name": "amonhen",
  "displayName": "Amon Hen",
  "description": "VSCode 上で快適に Git を操作するための自分用の拡張",
  "version": "0.0.1",
  "publisher": "fukusaka",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fukusaka/vscode-amonhen.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "amonhen",
          "title": "Amon Hen",
          "icon": "media/amonhen.svg"
        }
      ]
    },
    "views": {
      "amonhen": [
        {
          "id": "amonhen.sidebar",
          "name": "Repository"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "amonhen.sidebar",
        "contents": "Git リポジトリが見つかりません。\n[フォルダーを開く](command:vscode.openFolder)",
        "when": "!amonhen.hasRepository"
      }
    ],
    "commands": [
      {
        "command": "amonhen.refresh",
        "title": "Refresh",
        "category": "Amon Hen",
        "icon": "$(refresh)"
      },
      {
        "command": "amonhen.selectRepository",
        "title": "Select Repository",
        "category": "Amon Hen",
        "icon": "$(repo)"
      },
      {
        "command": "amonhen.checkout",
        "title": "Checkout",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.openChange",
        "title": "Open File",
        "category": "Amon Hen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "amonhen.selectRepository",
          "when": "view == amonhen.sidebar && amonhen.multipleRepositories",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.refresh",
          "when": "view == amonhen.sidebar",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "amonhen.checkout",
          "when": "view == amonhen.sidebar && viewItem == branch",
          "group": "1_branch@1"
        }
      ],
      "commandPalette": [
        {
          "command": "amonhen.checkout",
          "when": "false"
        },
        {
          "command": "amonhen.openChange",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --skip-license",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
