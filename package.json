{
  "name": "amonhen",
  "displayName": "Amon Hen",
  "description": "VSCode 上で快適に Git を操作するための自分用の拡張",
  "version": "0.0.1",
  "publisher": "fukusaka",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fukusaka/vscode-amonhen.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "amonhen",
          "title": "Amon Hen",
          "icon": "media/amonhen.svg"
        }
      ]
    },
    "views": {
      "amonhen": [
        {
          "id": "amonhen.sidebar",
          "name": "Repository"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "amonhen.sidebar",
        "contents": "Git リポジトリが見つかりません。\n[フォルダーを開く](command:vscode.openFolder)",
        "when": "!amonhen.hasRepository"
      }
    ],
    "commands": [
      {
        "command": "amonhen.refresh",
        "title": "Refresh",
        "category": "Amon Hen",
        "icon": "$(refresh)"
      },
      {
        "command": "amonhen.selectRepository",
        "title": "Select Repository",
        "category": "Amon Hen",
        "icon": "$(repo)"
      },
      {
        "command": "amonhen.checkout",
        "title": "Checkout",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.openChange",
        "title": "Open File",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.stage",
        "title": "Stage",
        "category": "Amon Hen",
        "icon": "$(add)"
      },
      {
        "command": "amonhen.unstage",
        "title": "Unstage",
        "category": "Amon Hen",
        "icon": "$(remove)"
      },
      {
        "command": "amonhen.stageSelection",
        "title": "Stage Selected Lines",
        "category": "Amon Hen",
        "icon": "$(add)",
        "enablement": "amonhen.diffKind == unstaged"
      },
      {
        "command": "amonhen.unstageSelection",
        "title": "Unstage Selected Lines",
        "category": "Amon Hen",
        "icon": "$(remove)",
        "enablement": "amonhen.diffKind == staged"
      },
      {
        "command": "amonhen.commit",
        "title": "Commit",
        "category": "Amon Hen",
        "icon": "$(check)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.undo",
        "title": "Undo Last Operation",
        "category": "Amon Hen",
        "icon": "$(discard)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.fetch",
        "title": "Fetch",
        "category": "Amon Hen",
        "icon": "$(cloud-download)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.showHistory",
        "title": "Show History",
        "category": "Amon Hen",
        "icon": "$(history)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.continueSequence",
        "title": "Continue",
        "category": "Amon Hen",
        "icon": "$(debug-continue)"
      },
      {
        "command": "amonhen.abortSequence",
        "title": "Abort",
        "category": "Amon Hen",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "amonhen.showHistory",
          "when": "view == amonhen.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "amonhen.commit",
          "when": "view == amonhen.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "amonhen.undo",
          "when": "view == amonhen.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.selectRepository",
          "when": "view == amonhen.sidebar && amonhen.multipleRepositories",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.fetch",
          "when": "view == amonhen.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "amonhen.refresh",
          "when": "view == amonhen.sidebar",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "amonhen.checkout",
          "when": "view == amonhen.sidebar && viewItem == branch",
          "group": "1_branch@1"
        },
        {
          "command": "amonhen.stage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.(unstaged|conflicts)$/",
          "group": "inline"
        },
        {
          "command": "amonhen.unstage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.staged$/",
          "group": "inline"
        },
        {
          "command": "amonhen.stage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.(unstaged|conflicts)$/",
          "group": "1_stage@1"
        },
        {
          "command": "amonhen.unstage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.staged$/",
          "group": "1_stage@1"
        },
        {
          "command": "amonhen.commit",
          "when": "view == amonhen.sidebar && viewItem == section.workingCopy",
          "group": "inline"
        },
        {
          "command": "amonhen.continueSequence",
          "when": "view == amonhen.sidebar && viewItem == sequence",
          "group": "inline@1"
        },
        {
          "command": "amonhen.abortSequence",
          "when": "view == amonhen.sidebar && viewItem == sequence",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "amonhen.checkout",
          "when": "false"
        },
        {
          "command": "amonhen.openChange",
          "when": "false"
        },
        {
          "command": "amonhen.stage",
          "when": "false"
        },
        {
          "command": "amonhen.unstage",
          "when": "false"
        },
        {
          "command": "amonhen.stageSelection",
          "when": "amonhen.diffKind == unstaged"
        },
        {
          "command": "amonhen.unstageSelection",
          "when": "amonhen.diffKind == staged"
        },
        {
          "command": "amonhen.continueSequence",
          "when": "amonhen.hasRepository"
        },
        {
          "command": "amonhen.abortSequence",
          "when": "amonhen.hasRepository"
        }
      ],
      "editor/title": [
        {
          "command": "amonhen.stageSelection",
          "when": "amonhen.diffKind == unstaged",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.unstageSelection",
          "when": "amonhen.diffKind == staged",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "amonhen.stageSelection",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && amonhen.diffKind == unstaged"
      },
      {
        "command": "amonhen.unstageSelection",
        "key": "ctrl+alt+u",
        "when": "editorTextFocus && amonhen.diffKind == staged"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --skip-license",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
