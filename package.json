{
  "name": "amonhen",
  "displayName": "Amon Hen",
  "description": "VSCode 上で快適に Git を操作するための自分用の拡張",
  "version": "0.0.2",
  "publisher": "fukusaka",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fukusaka/vscode-amonhen.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "amonhen",
          "title": "Amon Hen",
          "icon": "media/amonhen.svg"
        }
      ]
    },
    "views": {
      "amonhen": [
        {
          "id": "amonhen.sidebar",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "amonhen.sidebar",
        "contents": "Git リポジトリが見つかりません。\n[フォルダーを開く](command:vscode.openFolder)",
        "when": "!amonhen.hasRepository"
      }
    ],
    "commands": [
      {
        "command": "amonhen.refresh",
        "title": "Refresh",
        "category": "Amon Hen",
        "icon": "$(refresh)"
      },
      {
        "command": "amonhen.selectRepository",
        "title": "Select Repository",
        "category": "Amon Hen",
        "icon": "$(repo)"
      },
      {
        "command": "amonhen.openChange",
        "title": "Open File",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.stage",
        "title": "Stage",
        "category": "Amon Hen",
        "icon": "$(add)"
      },
      {
        "command": "amonhen.unstage",
        "title": "Unstage",
        "category": "Amon Hen",
        "icon": "$(remove)"
      },
      {
        "command": "amonhen.stageSelection",
        "title": "Stage Selected Lines",
        "category": "Amon Hen",
        "icon": "$(add)",
        "enablement": "amonhen.diffKind == unstaged"
      },
      {
        "command": "amonhen.unstageSelection",
        "title": "Unstage Selected Lines",
        "category": "Amon Hen",
        "icon": "$(remove)",
        "enablement": "amonhen.diffKind == staged"
      },
      {
        "command": "amonhen.commit",
        "title": "Commit",
        "category": "Amon Hen",
        "icon": "$(check)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.undo",
        "title": "Undo Last Operation",
        "category": "Amon Hen",
        "icon": "$(discard)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.fetch",
        "title": "Fetch",
        "category": "Amon Hen",
        "icon": "$(cloud-download)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.showHistory",
        "title": "Show History",
        "category": "Amon Hen",
        "icon": "$(history)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.continueSequence",
        "title": "Continue",
        "category": "Amon Hen",
        "icon": "$(debug-continue)"
      },
      {
        "command": "amonhen.abortSequence",
        "title": "Abort",
        "category": "Amon Hen",
        "icon": "$(close)"
      },
      {
        "command": "amonhen.history.reword",
        "title": "Reword…",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.squash",
        "title": "Squash into Parent…",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.fixup",
        "title": "Fixup into Parent",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.edit",
        "title": "Edit (Stop Here)",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.split",
        "title": "Split…",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.drop",
        "title": "Drop…",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.moveUp",
        "title": "Move Up",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.moveDown",
        "title": "Move Down",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.history.copyId",
        "title": "Copy Commit ID",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.acceptCurrent",
        "title": "Accept Current",
        "category": "Amon Hen",
        "icon": "$(arrow-left)"
      },
      {
        "command": "amonhen.acceptIncoming",
        "title": "Accept Incoming",
        "category": "Amon Hen",
        "icon": "$(arrow-right)"
      },
      {
        "command": "amonhen.skipSequence",
        "title": "Skip",
        "category": "Amon Hen",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "amonhen.open",
        "title": "Open Amon Hen",
        "category": "Amon Hen",
        "icon": "$(window)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.pull",
        "title": "Pull",
        "category": "Amon Hen",
        "icon": "$(repo-pull)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.push",
        "title": "Push",
        "category": "Amon Hen",
        "icon": "$(repo-push)",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.forcePush",
        "title": "Force Push",
        "category": "Amon Hen",
        "enablement": "amonhen.hasRepository"
      },
      {
        "command": "amonhen.nav.checkout",
        "title": "Checkout",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.nav.merge",
        "title": "Merge into Current Branch",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.nav.rebase",
        "title": "Rebase Current Branch onto This",
        "category": "Amon Hen"
      },
      {
        "command": "amonhen.nav.delete",
        "title": "Delete Branch…",
        "category": "Amon Hen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "amonhen.open",
          "when": "view == amonhen.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "amonhen.commit",
          "when": "view == amonhen.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "amonhen.undo",
          "when": "view == amonhen.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.selectRepository",
          "when": "view == amonhen.sidebar && amonhen.multipleRepositories",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.refresh",
          "when": "view == amonhen.sidebar",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "amonhen.stage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.(unstaged|conflicts)$/",
          "group": "inline"
        },
        {
          "command": "amonhen.unstage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.staged$/",
          "group": "inline"
        },
        {
          "command": "amonhen.stage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.(unstaged|conflicts)$/",
          "group": "1_stage@1"
        },
        {
          "command": "amonhen.unstage",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.staged$/",
          "group": "1_stage@1"
        },
        {
          "command": "amonhen.commit",
          "when": "view == amonhen.sidebar && viewItem == section.workingCopy",
          "group": "inline"
        },
        {
          "command": "amonhen.continueSequence",
          "when": "view == amonhen.sidebar && viewItem =~ /^sequence\\./",
          "group": "inline@1"
        },
        {
          "command": "amonhen.abortSequence",
          "when": "view == amonhen.sidebar && viewItem =~ /^sequence\\./",
          "group": "inline@3"
        },
        {
          "command": "amonhen.acceptCurrent",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.conflicts$/",
          "group": "2_conflict@1"
        },
        {
          "command": "amonhen.acceptIncoming",
          "when": "view == amonhen.sidebar && viewItem =~ /^(change|group)\\.conflicts$/",
          "group": "2_conflict@2"
        },
        {
          "command": "amonhen.skipSequence",
          "when": "view == amonhen.sidebar && viewItem =~ /^sequence\\.(rebase|cherry-pick|revert)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "amonhen.openChange",
          "when": "false"
        },
        {
          "command": "amonhen.stage",
          "when": "false"
        },
        {
          "command": "amonhen.unstage",
          "when": "false"
        },
        {
          "command": "amonhen.stageSelection",
          "when": "amonhen.diffKind == unstaged"
        },
        {
          "command": "amonhen.unstageSelection",
          "when": "amonhen.diffKind == staged"
        },
        {
          "command": "amonhen.continueSequence",
          "when": "amonhen.hasRepository"
        },
        {
          "command": "amonhen.abortSequence",
          "when": "amonhen.hasRepository"
        },
        {
          "command": "amonhen.history.reword",
          "when": "false"
        },
        {
          "command": "amonhen.history.squash",
          "when": "false"
        },
        {
          "command": "amonhen.history.fixup",
          "when": "false"
        },
        {
          "command": "amonhen.history.edit",
          "when": "false"
        },
        {
          "command": "amonhen.history.split",
          "when": "false"
        },
        {
          "command": "amonhen.history.drop",
          "when": "false"
        },
        {
          "command": "amonhen.history.moveUp",
          "when": "false"
        },
        {
          "command": "amonhen.history.moveDown",
          "when": "false"
        },
        {
          "command": "amonhen.history.copyId",
          "when": "false"
        },
        {
          "command": "amonhen.acceptCurrent",
          "when": "false"
        },
        {
          "command": "amonhen.acceptIncoming",
          "when": "false"
        },
        {
          "command": "amonhen.skipSequence",
          "when": "amonhen.hasRepository"
        },
        {
          "command": "amonhen.nav.checkout",
          "when": "false"
        },
        {
          "command": "amonhen.nav.merge",
          "when": "false"
        },
        {
          "command": "amonhen.nav.rebase",
          "when": "false"
        },
        {
          "command": "amonhen.nav.delete",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "amonhen.stageSelection",
          "when": "amonhen.diffKind == unstaged",
          "group": "navigation@1"
        },
        {
          "command": "amonhen.unstageSelection",
          "when": "amonhen.diffKind == staged",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "amonhen.history.reword",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "1_message@1"
        },
        {
          "command": "amonhen.history.squash",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitCanSquash",
          "group": "1_message@2"
        },
        {
          "command": "amonhen.history.fixup",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitCanSquash",
          "group": "1_message@3"
        },
        {
          "command": "amonhen.history.edit",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "2_rewrite@1"
        },
        {
          "command": "amonhen.history.split",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "2_rewrite@2"
        },
        {
          "command": "amonhen.history.drop",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "2_rewrite@3"
        },
        {
          "command": "amonhen.history.moveUp",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "3_move@1"
        },
        {
          "command": "amonhen.history.moveDown",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit' && commitEditable",
          "group": "3_move@2"
        },
        {
          "command": "amonhen.history.copyId",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'commit'",
          "group": "9_copy@1"
        },
        {
          "command": "amonhen.nav.checkout",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'navRef' && !current && refKind != 'tag'",
          "group": "1_ref@1"
        },
        {
          "command": "amonhen.nav.merge",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'navRef' && !current",
          "group": "2_ref@1"
        },
        {
          "command": "amonhen.nav.rebase",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'navRef' && !current",
          "group": "2_ref@2"
        },
        {
          "command": "amonhen.nav.delete",
          "when": "webviewId == 'amonhen.main' && webviewSection == 'navRef' && !current && refKind == 'branch'",
          "group": "3_ref@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "amonhen.stageSelection",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && amonhen.diffKind == unstaged"
      },
      {
        "command": "amonhen.unstageSelection",
        "key": "ctrl+alt+u",
        "when": "editorTextFocus && amonhen.diffKind == staged"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --skip-license",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
